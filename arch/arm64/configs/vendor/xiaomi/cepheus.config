# Platform
CONFIG_MACH_XIAOMI_CEPHEUS=y

# CS35L41 is not yet integrated: do not enable a driver symbol until the
# component-API conversion, Kbuild integration, and board routing are complete.

# The msmnile camera actuator core includes the AK7374 anti-noise sequence
# under CONFIG_MACH_XIAOMI_CEPHEUS (not CONFIG_VCM_AK7374). It checks the CCI
# SID before touching actuator registers; verify the selected actuator node and
# sequence on hardware before treating camera stabilization as validated.

# Wireless charging
CONFIG_IDT_P9220=y

# Touchscreen: use Xiaomi's FTS V521 fork, not the generic ST integration.
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_FTS_FOD_AREA_REPORT=y
# CONFIG_SECURE_TOUCH is not set
# CONFIG_I2C_BY_DMA is not set
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_EXPOSURE_ADJUSTMENT=y
