# Platform
CONFIG_MACH_XIAOMI_CEPHEUS=y

# Audio: Cepheus uses the CS35L41 smart amplifier path.
CONFIG_SND_SOC_CS35L41=y
CONFIG_MSM_CSPL=y

# Camera actuator
CONFIG_VCM_AK7374=y

# Wireless charging
CONFIG_IDT_P9220=y

# Touchscreen: the 4.14 Cepheus driver is Xiaomi's FTS V521 fork.
# Do not substitute CONFIG_TOUCHSCREEN_ST: the 5.4 tree's generic ST
# driver is a different integration. The FTS V521 driver/Kconfig/Makefile
# must be ported before enabling CONFIG_TOUCHSCREEN_ST_FTS_V521.
# CONFIG_TOUCHSCREEN_ST_FTS_V521 is not set
# CONFIG_FTS_FOD_AREA_REPORT is not set
# CONFIG_SECURE_TOUCH is not set
# CONFIG_I2C_BY_DMA is not set
# CONFIG_TOUCHSCREEN_COMMON is not set
