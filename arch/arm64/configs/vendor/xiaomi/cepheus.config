# Platform
CONFIG_MACH_XIAOMI_CEPHEUS=y

# CS35L41 codec source and techpack Kbuild integration are ported.
# Build and runtime validation are still required. CSPL mailbox handling is
# implemented inside the codec driver; CONFIG_MSM_CSPL is not a valid symbol.
CONFIG_SND_SOC_CS35L41=y

# The msmnile camera actuator core contains the AK7374 anti-noise sequence.
# Its legacy CONFIG_VCM_AK7374 guard is enabled for Cepheus only by
# techpack/camera-msmnile/config/msmnilecameraconf.h. The sequence checks the
# CCI SID before touching actuator registers; runtime validation is still due.

# Wireless charging
CONFIG_IDT_P9220=y

# Touchscreen: use Xiaomi's FTS V521 fork, not the generic ST integration.
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_FTS_FOD_AREA_REPORT=y
# CONFIG_SECURE_TOUCH is not set
# CONFIG_I2C_BY_DMA is not set
CONFIG_TOUCHSCREEN_COMMON=y
